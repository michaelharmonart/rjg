            "execute_in": "/bind_skin"
        },
        "/matrix_spline": {
            "code": [
                "",
                "part_group = cmds.group(empty=True, name=\"${component_group}\", parent=\"${mch_parent}\")",
                "if ${group_constrain} is not None:",
                "    ",
                "",
                "cmds.refresh()"
            ]
        },
