                    "value": "[\"trunk_def\"]"
                }
            }
        },
        "/setup_file/split_dicts": {
            "attrs": {
                "split_dicts": {
                    "type": "list",
                    "value": "[\"trunk_split\"]"
                }
            },
            "code": [
                "for split_dict in self.split_dicts:",
                "    setattr(STAGE, split_dict, {})"
            ]
        },
        "/trunk": {
            "instance": "/component",
            "execute_in": "/base",
            "child_order": [
                "bottom_pivot",
                "trunk_spline"
            ],
            "attrs": {
                "base_scale_attr": {},
                "name": {
                    "value": "trunk"
                },
                "top_scale_attr": {}
            },
            "code": [
                "import rjg.libs.attribute",
                "",
                "part_group = cmds.group(empty=True, name=\"${component_group}\", parent=\"${mch_parent}\")",
                "top_scale_attr = rjg.libs.attribute.Attribute(",
                "                node=part_group, type=\"double\", min=0.01, max=5, value=1, keyable=True, name=\"topScale\"",
                "            )",
                "self.top_scale_attr = top_scale_attr.attr",
                "base_scale_attr = rjg.libs.attribute.Attribute(",
                "                node=part_group, type=\"double\", min=0.01, max=5, value=1, keyable=True, name=\"baseScale\"",
                "            )",
                "self.base_scale_attr = base_scale_attr.attr",
                "cmds.refresh()"
            ]
        },
        "/trunk/bottom_pivot": {
            "instance": "/basic_control",
            "execute_in": "/base",
            "attrs": {
                "guide": {
                    "type": "raw",
                    "value": "trunk_base"
                },
                "name": {
                    "type": "raw",
                    "value": "bottom_pivot"
                },
                "side": {
                    "value": "M"
                },
                "size": {
                    "type": "int",
                    "value": "250"
                }
            },
            "code": [
                "import rjg.libs.control.ctrl",
                "",
                "control = rjg.libs.control.ctrl.Control(",
                "            name=\"${name}\", ",
                "            ctrl_scale=${size}, ",
                "            shape=\"${shape}\",",
                "            parent=\"${parent}\",",
                "            translate=\"${guide}\",",
                "            rotate=\"${guide}\",",
                "            scale=\"${guide}\",",
                "            side=\"${side}\"",
                ")",
                "self.control_transform = control.ctrl",
                "cmds.addAttr(control.ctrl, longName=\"topScale\", proxy=\"${top_scale_attr}\")",
                "cmds.addAttr(control.ctrl, longName=\"baseScale\", proxy=\"${base_scale_attr}\")",
                "cmds.refresh()"
            ]
        },
        "/trunk/trunk_spline": {
            "instance": "/matrix_spline",
            "child_order": [
                "controls",
                "joints"
            ],
            "attrs": {
                "control_shape": {
                    "type": "raw",
                    "value": "square"
                },
                "control_size": {
                    "type": "int",
                    "value": "50"
                },
                "ctl_parent": {
                    "type": "raw",
                    "value": "bottom_pivot_M_CTRL"
                },
                "degree": {
                    "type": "int",
                    "value": "3"
                },
                "group_constrain": {
                    "value": "bottom_pivot_M_CTRL"
                },
                "guides": {
                    "type": "list",
                    "value": "[\"trunk_base\", \"trunk_mid1\",  \"trunk_mid2\", \"trunk_top\"]"
                },
                "mch_parent": {
                    "value": "${../.component_group}"
                },
                "name": {
                    "value": "trunk_spline"
                },
                "padded": {
                    "value": "False"
                },
                "segments": {
                    "value": "8"
                }
            },
            "code": [
                "import rjg.libs.transform",
                "part_group = cmds.group(empty=True, name=\"${component_group}\", parent=\"${mch_parent}\")",
                "rjg.libs.transform.matrix_constraint(\"${ctl_parent}\", part_group)",
                "cmds.refresh()"
            ]
        },
        "/trunk/trunk_spline/controls": {
            "code": [
                "import rjg.libs.control.ctrl",
                "import rjg.libs.transform",
                "import rjg.libs.spline.matrix_spline",
                "guides = ${guides}",
                "controls = []",
                "shape=\"${control_shape}\"",
                "",
                "base_pin = cmds.group(empty=True, name=\"${name}_base_scale\", parent=\"${component_group}\")",
                "top_pin = cmds.group(empty=True, name=\"${name}_top_scale\", parent=\"${component_group}\")",
                "",
                "cmds.connectAttr(\"${base_scale_attr}\", f\"{base_pin}.scaleX\")",
                "cmds.connectAttr(\"${base_scale_attr}\", f\"{base_pin}.scaleY\")",
                "cmds.connectAttr(\"${base_scale_attr}\", f\"{base_pin}.scaleZ\")",
                "cmds.connectAttr(\"${top_scale_attr}\", f\"{top_pin}.scaleX\")",
                "cmds.connectAttr(\"${top_scale_attr}\", f\"{top_pin}.scaleY\")",
                "cmds.connectAttr(\"${top_scale_attr}\", f\"{top_pin}.scaleZ\")",
                "",
                "scale_spline = rjg.libs.spline.matrix_spline.MatrixSpline(",
                "    cv_transforms=[base_pin, top_pin], ",
                "    degree=1, ",
                "    name=\"${name}_scaleSpline\", ",
                ")",
                "",
                "scale_pins = []",
                "for i, guide in enumerate(guides):",
                "    pivot_transform = guide",
                "    shape_transform = guide",
                "    if i == (len(guides) - 1):",
                "        pivot_transform = guides[i-2]",
                "    control_pin = cmds.group(empty=True, name=f\"{guide}_ControlPin\", parent=\"${component_group}\")",
                "    rjg.libs.transform.match_transform(control_pin, guide)",
                "    if i > 1:",
                "        control = rjg.libs.control.ctrl.Control(",
                "            name = guide, ",
                "            ctrl_scale = ${control_size}, ",
                "            shape = shape,",
                "            parent = \"${ctl_parent}\",",
                "            translate = pivot_transform,",
                "            rotate = pivot_transform,",
                "            scale = pivot_transform,",
                "            shape_translate = shape_transform,",
                "        )",
                "        controls.append(control)",
                "        rjg.libs.transform.matrix_constraint(control.ctrl, control_pin)",
                "    ",
                "    scale_pin = cmds.group(empty=True, name=f\"{guide}_ScalePin\", parent=control_pin)",
                "    parameter = (i / (len(guides) - 1))",
                "    rjg.libs.spline.matrix_spline.scale_with_matrix_spline(matrix_spline=scale_spline, parameter=parameter, scaled_transform=scale_pin)",
                "    scale_pins.append(scale_pin)",
                "",
                "self.ctl_transforms = scale_pins",
                "self.ctl_offsets = [control.top for control in controls]"
            ]
        },
        "/trunk/trunk_spline/joints": {
            "attrs": {
                "split_dict": {
                    "value": "trunk_split"
                }
            }
        }
    }
}