    "nodes": {
        "/basic_control": {
            "attrs": {
                "control_transform": {},
                "guide": {},
                "name": {
                    "type": "raw",
                    "value": "basic"
                },
                "parent": {
                    "type": "raw",
                    "value": "${controls_parent}"
                },
                "shape": {
                    "type": "raw",
                    "value": "circle"
                },
                "side": {
                    "type": "raw"
                },
                "size": {
                    "type": "int",
                    "value": "1"
                }
            },
            "code": [
                "import rjg.libs.control.ctrl",
                "",
                "control = rjg.libs.control.ctrl.Control(",
                "            name=\"${name}\", ",
                "            ctrl_scale=${size}, ",
                "            shape=\"${shape}\",",
                "            parent=\"${parent}\",",
                "            translate=\"${guide}\",",
                "            rotate=\"${guide}\",",
                "            scale=\"${guide}\",",
                "            side=\"${side}\"",
                ")",
                "self.control_transform = control.ctrl",
                "cmds.refresh()"
            ]
        },
        "/component": {
            "attrs": {
                "component_group": {
                    "type": "raw",
                    "value": "${name}_MCH"
                },
                "ctl_parent": {
                    "type": "raw",
                    "value": "${controls_parent}"
                },
                "def_parent": {
                    "type": "raw",
                    "value": "${def_group}"
                },
                "guides": {
                    "type": "list",
                    "value": "[]"
                },
                "mch_parent": {
                    "type": "raw",
                    "value": "${mch_group}"
                },
                "name": {
                    "type": "raw",
                    "value": "component_${side}"
                },
                "side": {
                    "type": "raw",
                    "value": "M"
                }
            },
            "code": [
                "part_group = cmds.group(empty=True, name=\"${component_group}\", parent=\"${mch_parent}\")",
                "cmds.refresh()"
            ]
        },
        "/matrix_spline": {
            "instance": "/component",
            "child_order": [
                "controls",
                "joints",
                "spline"
            ],
            "attrs": {
                "control_shape": {
                    "type": "raw",
                    "value": "circle"
                },
                "control_size": {
                    "type": "int",
                    "value": "1"
                },
                "degree": {
                    "type": "int",
                    "value": "3"
                },
                "driven_transforms": {
                    "type": "NoneType",
                    "value": "None"
                },
                "name": {
                    "type": "raw",
                    "value": "matrix_spline"
                },
                "padded": {
                    "type": "bool",
                    "value": "True"
                },
                "segments": {
                    "type": "int",
                    "value": "6"
                }
            },
            "code": [
                "part_group = cmds.group(empty=True, name=\"${component_group}\", parent=\"${mch_parent}\")",
                "cmds.refresh()"
            ]
        },
        "/matrix_spline/controls": {
            "attrs": {
                "ctl_offsets": {
                    "type": "list",
                    "value": "[]"
                },
                "ctl_transforms": {
                    "type": "list",
                    "value": "[]"
                }
            },
            "code": [
                "import rjg.libs.control.ctrl",
                "guides = ${guides}",
                "",
                "controls = []",
                "for guide in guides:",
                "    control = rjg.libs.control.ctrl.Control(",
                "        name = guide, ",
                "        ctrl_scale = ${control_size}, ",
                "        shape =\"${control_shape}\",",
                "        parent = \"${ctl_parent}\",",
                "        translate = guide,",
                "        rotate = guide,",
                "        scale = guide,",
                "    )",
                "    controls.append(control)",
                "self.ctl_transforms = [control.ctrl for control in controls]",
                "self.ctl_offsets = [control.top for control in controls]"
            ]
        },
        "/matrix_spline/joints": {
            "attrs": {
                "joint_set": {},
                "joint_transforms": {
                    "type": "list",
                    "value": "[]"
                },
                "split_dict": {}
            },
            "code": [
                "joints = []",
                "for i in range(${segments}):",
                "    segment_name = f\"${name}_{i:02d}_JNT\"",
                "    joint = cmds.joint(name=segment_name)",
                "    cmds.parent(joint, \"${def_parent}\")",
                "    joints.append(joint)",
                "self.joint_transforms = joints",
                "STAGE.${joint_set}.extend(joints)    ",
                "if \"${split_dict}\":",
                "    split_dict = getattr(STAGE, \"${split_dict}\")",
                "    split_dict[joints[0]] = joints",
                "    setattr(STAGE, \"${split_dict}\", split_dict)"
            ]
        },
        "/matrix_spline/spline": {
            "attrs": {
                "create_curve": {
                    "type": "bool",
                    "value": "False"
                }
            },
            "code": [
                "import rjg.libs.spline.matrix_spline",
                "",
                "if ${driven_transforms} is not None:",
                "    driven_transforms = ${driven_transforms}",
                "else:",
                "    driven_transforms = ${../joints.joint_transforms}",
                "",
                "matrix_spline = rjg.libs.spline.matrix_spline.matrix_spline_from_transforms(",
                "    name = \"${name}\",",
                "    degree = ${degree},",
                "    spline_group = \"${component_group}\",",
                "    transforms = ${../controls.ctl_transforms},",
                "    transforms_to_pin = driven_transforms,",
                "    padded = ${padded},",
                ")",
                "if ${create_curve}:",
                "    rjg.libs.spline.matrix_spline.bound_curve_from_matrix_spline(matrix_spline, curve_parent=\"${component_group}\")",
                "cmds.refresh()"
            ]
        }
    }
}